# PickForMe Incident Triage Agent 環境變數範本
# 僅需唯讀觀測設定與 LLM API Key

# LLM 設定
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Langfuse 觀測設定 (唯讀查詢失敗/低分 Trace)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Neon Serverless Postgres 連線字串 (建議使用唯讀帳號)
DATABASE_URL=postgresql://user:password@localhost:5432/pickforme

# 選用：其他 LLM Provider 健康檢查
GROQ_API_KEY=your_groq_api_key
OLLAMA_BASE_URL=http://localhost:11434

# 選用：Telegram Bot（部署至 GCP Cloud Run 遠端排查用）
TELEGRAM_BOT_TOKEN=your_admin_telegram_bot_token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
